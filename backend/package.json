{
  "name": "team-toolbox-backend",
  "version": "0.1.1",
  "private": true,
  "description": "team-toolbox backend (Express + better-sqlite3)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/migrate.js",
    "rebuild": "npm rebuild better-sqlite3",
    "test": "node --test src/store.test.js src/api.test.js src/asset-store.test.js src/asset-api.test.js src/asset-mirror.test.js src/asset-preview.test.js src/db.test.js src/full-backup.test.js src/search-index.test.js src/asset-reference.test.js src/document-trash.test.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.5.0",
    "busboy": "^1.6.0",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "marked": "^14.1.3",
    "sanitize-html": "^2.13.1",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0"
  }
}
