# team-toolbox 后端环境变量样例
# 复制本文件为 .env 并按需修改；真实 .env 已被 .gitignore 排除。

# HTTP 服务绑定地址与端口
# 默认 127.0.0.1:3000，仅本机访问；如需内网，把 HOST 改为内网网卡地址（如 192.168.x.x）
# 严禁设为 0.0.0.0 暴露到公网（本系统第一版无任何认证，详见 ARCHITECTURE 第 7 节）。
HOST=127.0.0.1
PORT=3000

# SQLite 数据库文件路径（相对于项目根目录）
# 默认 data/team-toolbox.sqlite3；可设为绝对路径或相对路径（均以项目根为基准）
DB_PATH=data/team-toolbox.sqlite3

# 备份输出目录（被 .gitignore 排除）
BACKUP_DIR=backups

# 节点运行环境（development | production）
NODE_ENV=development