# 前端本地配置（dev server 行为，不含密钥）
# 与 backend/.env.example 区分：本文件仅影响 Vite dev server；构建产物由 Vite 静态化。

# 直接 npm run dev 默认仅本机；局域网须同时设 TOOLBOX_ALLOW_LAN=1 与 VITE_DEV_HOST=0.0.0.0。
# Windows 启动器会统一设置前后端；此开关不进入前端构建产物。
TOOLBOX_ALLOW_LAN=0
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173
# 开发代理的后端端口；启动器与后端保持一致。
PORT=3000

# 后端 API 基址（前端通过 fetch 调用）
# Vite dev server 会把以 VITE_API_BASE 开头的请求代理到后端；详见 vite.config.js
VITE_API_BASE=/api
