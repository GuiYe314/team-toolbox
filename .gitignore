# ---- 依赖 ----
node_modules/
.venv/
venv/
__pycache__/
vendor/

# ---- 构建产物 ----
dist/
build/
out/
target/
.next/
.cache/

# ---- 发布产物（只通过 GitHub Release 分发，不入源码历史）----
release/
# 打包脚本生成的临时 .iss（模板 installer/team-toolbox.iss 要入库）
installer/team-toolbox-*.iss
!installer/team-toolbox.iss

# ---- 密钥与环境变量（保留示例文件）----
.env
.env.*
!.env.example
!env.example
env.local
*.pem
*.key
secrets/

# ---- 本地数据与备份（团队数据不入库）----
data/
backups/
*.db
*.sqlite
*.sqlite3
*.bak

# ---- 日志 ----
logs/
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- 编辑器与系统 ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- 本地工作区（记忆日志、验证脚本、截图，不入库）----
.workbuddy/

